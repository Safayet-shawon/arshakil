# --- Inquiries (hire requests + messages) ---
# URL of the NestJS API (see ../backend). Server-side only: the browser never calls it directly.
# Set it and every message is stored in PostgreSQL by the backend. Leave it unset to keep using the old private Blob store
# (handy on Vercel before the backend is live).
INQUIRIES_API_URL=http://localhost:4000/api
# Must equal ADMIN_API_KEY in backend/.env. Never expose it with a NEXT_PUBLIC_ prefix.
ADMIN_API_KEY=

# --- Admin panel login (/ar6061) ---
# ADMIN_SECRET signs the login cookie; ADMIN_USER / ADMIN_PASS are the first login until changed in the panel.
ADMIN_SECRET=
ADMIN_USER=
ADMIN_PASS=

# --- Emails ---
# Used only when INQUIRIES_API_URL is NOT set (then this site emails you). With the backend, set these in backend/.env instead.
# RESEND_API_KEY=
# CONTACT_TO=
# CONTACT_FROM=

# Vercel Blob (site content, uploads, book PDFs)
# BLOB_READ_WRITE_TOKEN=
