# Copied to backend/.env, this file is loaded automatically when the API starts (variables already set in the shell win).
PORT=4000
# Comma-separated list of origins allowed to call the API (the Next.js frontend)
FRONTEND_URL=http://localhost:3000,http://localhost:3100

# PostgreSQL: stores the inquiries (hire requests + messages) as the owner's inbox / history.
# Local:  docker compose up -d postgres   (from the repo root)
DATABASE_URL=postgres://arshakil:arshakil_dev@localhost:5432/arshakil
# DATABASE_SSL=true            # for a managed database that requires TLS
# DB_SYNCHRONIZE=false         # dev only: set false to stop auto-building tables from the entity
# In production (NODE_ENV=production) tables come only from migrations, which run on start.

# Secret the Next.js server sends as `x-admin-key` to reach /api/admin/*. Use 24+ random characters, e.g.
#   openssl rand -hex 32
# The same value goes into frontend/.env.local. With this unset, admin endpoints are disabled.
ADMIN_API_KEY=

# Redis powers the contact-form rate limit. Leave empty to use the in-memory fallback.
# Local:  docker compose up -d redis   (from the repo root)
REDIS_URL=redis://localhost:6379

# Behind nginx set this to 1 so the rate limit sees the visitor's IP, not nginx's.
# TRUST_PROXY=1

# Email a copy of every inquiry to the owner (optional; without these the inbox in the admin panel is still the record).
# RESEND_API_KEY=
# CONTACT_TO=owner@example.com
# CONTACT_FROM=Portfolio <no-reply@yourdomain.com>
